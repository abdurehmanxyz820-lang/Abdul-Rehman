# Gemini AI API Key (AI Studio automatically injects this from the Secrets panel)
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Supabase PostgreSQL & Auth Backend
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-token
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-migrations

# Payment & Billing (Stripe / RevenueCat Sandbox)
STRIPE_PUBLISHABLE_KEY=pk_test_medisync_sandbox
STRIPE_WEBHOOK_SECRET=whsec_medisync_test_secret

# Agency Environment
MEDISYNC_AGENCY_ID=st-jude-home-health
MEDISYNC_DEV_PAYMENT_MODE=true
